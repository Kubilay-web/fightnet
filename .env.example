# =============================================================================
# FIGHTNET — ortam değişkenleri
#
# Bu dosya şablondur, `.env` olarak kopyalayın. `.env` git'e girmez.
#
# GÜVENLİK: Canlı (sk_live_…) anahtarları asla depoya, sohbete, ekran
# görüntüsüne veya issue'ya yapıştırmayın. Yapıştırıldıysa anahtar yanmıştır;
# Stripe Dashboard → Developers → API keys üzerinden derhal roll edin.
# Geliştirme ve Beta 0–2 aşamalarında yalnızca test anahtarı kullanın.
# =============================================================================

# --- Zorunlu ---------------------------------------------------------------
DATABASE_URL="mongodb+srv://kullanici:parola@cluster/fightnet"
# En az 32 karakter. Üretmek için: openssl rand -base64 48
AUTH_SECRET="change-me-min-32-chars-change-me-min-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FIGHTNET"

# --- Medya (Cloudinary) ----------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="fightnet"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Push bildirimleri (§4.1) ---------------------------------------------
# Üretmek için: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@fightnet.app"

# --- E-posta ---------------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="FIGHTNET <noreply@fightnet.app>"

# --- Cron (KPI anlık görüntüsü, §7) ---------------------------------------
CRON_SECRET=""

# =============================================================================
# ÖDEMELER — Stripe Connect (§4.6, §4.7, §5.3)
# Boş bırakılırsa: abonelik/sipariş kayıtları oluşur, tahsilat yapılmaz ve
# kullanıcıya "ödeme yapılandırılmamış" uyarısı gösterilir.
# =============================================================================
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# =============================================================================
# SEPA + FATURA (§4.6) — salon sözleşme yönetimi
# Gläubiger-ID Bundesbank'tan alınır.
# =============================================================================
SEPA_CREDITOR_ID=""
SEPA_CREDITOR_NAME="FIGHTNET"

# --- eIDAS imza ------------------------------------------------------------
# internal = dahili FES mührü (varsayılan, ek servis gerekmez)
# skribble / docusign = nitelikli imza (QES) için QTSP
ESIGN_PROVIDER="internal"
ESIGN_SECRET=""
SKRIBBLE_API_TOKEN=""
DOCUSIGN_ACCESS_TOKEN=""

# =============================================================================
# AWS (§5.4 Frankfurt) — Rekognition (§11.3) + IVS (§4.4)
# Boş bırakılırsa: moderasyon yerel sözlükle, yayın harici HLS adresiyle çalışır.
# =============================================================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-central-1"
IVS_PLAYBACK_KEY_ARN=""
IVS_PLAYBACK_PRIVATE_KEY=""

# --- İçerik moderasyonu (§11.3) -------------------------------------------
PERSPECTIVE_API_KEY=""

# =============================================================================
# KYC (§4.5 Seviye 1)
# Boş bırakılırsa: manuel belge + selfie akışı (/admin/dogrulama) kullanılır.
# =============================================================================
KYC_PROVIDER=""
ONFIDO_API_TOKEN=""
ONFIDO_WORKFLOW_ID=""
IDNOW_COMPANY_ID=""
IDNOW_API_KEY=""

# =============================================================================
# ARAMA / ANALİTİK / HARİTA — hepsi opsiyonel, hepsinin fallback'i var
# =============================================================================
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_KEY=""
ALGOLIA_INDEX_PREFIX="fightnet"

POSTHOG_API_KEY=""
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

MAPBOX_ACCESS_TOKEN=""
GOOGLE_PLACES_API_KEY=""

# =============================================================================
# DONANIM (§4.4) — Apple HealthKit ve Health Connect anahtar gerektirmez
# =============================================================================
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
POLAR_CLIENT_ID=""
POLAR_CLIENT_SECRET=""

# --- Seed ------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@fightnet.app"
SEED_ADMIN_PASSWORD=""
