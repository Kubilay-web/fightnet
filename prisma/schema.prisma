// FIGHTNET — DACH Dövüş Sporları Platformu
// Prisma + MongoDB

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  USER
  ATHLETE
  COACH
  GYM_OWNER
  ORGANIZER
  MODERATOR
  ADMIN
}

/// Doküman §4.5 — 3 seviyeli doğrulama sistemi
enum VerificationLevel {
  LEVEL_0 // E-posta onaylı
  LEVEL_1 // Kimlik + selfie (KYC)
  LEVEL_2 // Durum doğrulanmış (sporcu / antrenör / salon)
}

enum Discipline {
  MMA
  BOXING
  BJJ
  MUAY_THAI
  KICKBOXING
  WRESTLING
  JUDO
  KARATE
  SAMBO
  TAEKWONDO
  GRAPPLING
  KRAV_MAGA
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  SEMI_PRO
  PRO
}

enum BeltRank {
  WHITE
  BLUE
  PURPLE
  BROWN
  BLACK
  YELLOW
  ORANGE
  GREEN
  RED
  NONE
}

/// Doküman §8.3 — Görünürlük seviyeleri
enum Visibility {
  PUBLIC
  COMMUNITY
  GYM
  COACH
  ORGANIZER
  FEDERATION
  PRIVATE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum VouchStatus {
  PENDING
  ACCEPTED
  REVOKED
  REJECTED
}

enum EventType {
  AMATEUR
  PROFESSIONAL
  TOURNAMENT
  SEMINAR
  OPEN_MAT
  SMOKER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  FINISHED
  CANCELLED
}

enum FightStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
  NO_CONTEST
}

enum FightResultMethod {
  KO
  TKO
  SUBMISSION
  DECISION_UNANIMOUS
  DECISION_SPLIT
  DECISION_MAJORITY
  DQ
  DRAW
  NO_CONTEST
  POINTS
}

enum Corner {
  RED
  BLUE
}

enum SparringStatus {
  OPEN
  MATCHED
  COMPLETED
  CANCELLED
}

enum SparringRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum BookingType {
  TRIAL
  DROP_IN
  CLASS
  PRIVATE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum PostType {
  VIDEO
  IMAGE
  TEXT
}

enum ModerationState {
  PENDING
  APPROVED
  FLAGGED
  REMOVED
}

enum ReportReason {
  SPAM
  HARASSMENT
  VIOLENCE
  SEXUAL_CONTENT
  DOPING
  WEIGHT_CUT
  UNSAFE_SPARRING
  FAKE_PROFILE
  MINOR_SAFETY
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  FOLLOW
  SPARRING_REQUEST
  SPARRING_ACCEPTED
  LIVESCORE
  VOUCH
  VERIFICATION
  BOOKING
  COMMENT
  LIKE
  SUBSCRIPTION
  SYSTEM
  EVENT
  MESSAGE
}

enum SubscriptionTier {
  BRONZE
  SILVER
  GOLD
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
}

enum MembershipPlan {
  FOUNDER // 50 €/ay ömür boyu
  STANDARD // 100-150 €/ay
  TRIAL
}

enum GymStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLAIMED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  USED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum WaitlistStatus {
  PENDING
  INVITED
  CONVERTED
  UNSUBSCRIBED
}

enum SponsorshipStatus {
  OPEN
  APPLIED
  ACCEPTED
  REJECTED
  CLOSED
}

/// §4.4 — Müsabaka kayıt aracılığı
enum RegistrationStatus {
  PENDING
  ACCEPTED
  WAITLISTED
  REJECTED
  WITHDRAWN
}

/// §11.5 — DSA itiraz mekanizması
enum AppealStatus {
  OPEN
  UPHELD // moderasyon kararı korundu
  OVERTURNED // karar geri alındı
  DISMISSED
}

// ---------------------------------------------------------------------------
// KULLANICI & KİMLİK
// ---------------------------------------------------------------------------

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  email    String  @unique
  password String?
  username String  @unique
  name     String
  slug     String  @unique

  role         Role              @default(USER)
  roles        Role[]            @default([])
  verification VerificationLevel @default(LEVEL_0)

  emailVerified   DateTime?
  emailToken      String?
  resetToken      String?
  resetTokenExp   DateTime?
  twoFactorSecret String?
  mfaEnabled      Boolean   @default(false)

  // Profil
  avatarUrl   String?
  avatarId    String? // Cloudinary public_id
  coverUrl    String?
  coverId     String?
  bio         String?
  birthDate   DateTime?
  isMinor     Boolean   @default(false)
  guardianEmail String?
  guardianConsent Boolean @default(false)
  // §11.1 — ebeveyn onayı e-posta akışı
  guardianToken     String?
  guardianTokenExp  DateTime?
  guardianConsentAt DateTime?
  // §5.7 — granüler çerez/izin kaydı
  consent    Json?
  consentAt  DateTime?
  nationality String?
  city        String?
  country     String    @default("DE")
  postalCode  String?
  lat         Float?
  lng         Float?
  heightCm    Int?
  reachCm     Int?
  stance      String?
  phone       String?
  website     String?
  socials     Json?

  // Sayaçlar (denormalize — okuma hızı için)
  followerCount  Int @default(0)
  followingCount Int @default(0)
  postCount      Int @default(0)
  trainingStreak Int @default(0)
  longestStreak  Int @default(0)
  totalTrainings Int @default(0)
  profileScore   Int @default(0) // %  tamamlanma

  // Tercihler
  locale        String     @default("de")
  theme         String     @default("dark")
  visibility    Visibility @default(PUBLIC)
  pushEnabled   Boolean    @default(true)
  emailEnabled  Boolean    @default(true)
  pushTokens    String[]   @default([])

  // Durum
  isActive     Boolean   @default(true)
  isBanned     Boolean   @default(false)
  banReason    String?
  bannedUntil  DateTime?
  isFounder    Boolean   @default(false)
  founderSince DateTime?
  betaCodeUsed String?
  lastActiveAt DateTime?
  lastLoginAt  DateTime?

  // Ödeme (§4.6/§4.7) — kart verisi asla burada tutulmaz, yalnızca Stripe kimlikleri
  stripeCustomerId String?
  stripeAccountId  String?       // Connect Express — creator/antrenör ödemeleri
  connectStatus    ConnectStatus @default(NONE)

  // §4.4 Premium (reklamsız) ve §4.3 Antrenör-Araç SaaS erişim pencereleri
  premiumUntil    DateTime?
  coachToolsUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // İlişkiler
  sportProfiles       SportProfile[]
  trainingLogs        TrainingLog[]
  gymMemberships      GymMembership[]
  ownedGyms           Gym[]                  @relation("GymOwner")
  coachAt             GymCoach[]
  verificationReqs    VerificationRequest[]
  vouchesGiven        Vouch[]                @relation("VouchCoach")
  vouchesReceived     Vouch[]                @relation("VouchAthlete")
  sparringListings    SparringListing[]
  sparringRequests    SparringRequest[]      @relation("SparringSender")
  sparringReviewsMade SparringReview[]       @relation("ReviewAuthor")
  sparringReviewsGot  SparringReview[]       @relation("ReviewTarget")
  followers           Follow[]               @relation("Following")
  following           Follow[]               @relation("Follower")
  posts               Post[]
  postLikes           PostLike[]
  postComments        PostComment[]
  forumThreads        ForumThread[]
  forumPosts          ForumPost[]
  notifications       Notification[]         @relation("NotifUser")
  notificationsSent   Notification[]         @relation("NotifActor")
  bookings            Booking[]
  organizedEvents     Event[]                @relation("EventOrganizer")
  fightsRed           Fight[]                @relation("FightRed")
  fightsBlue          Fight[]                @relation("FightBlue")
  liveComments        LiveComment[]
  creatorTiers        CreatorTier[]
  subscriptions       CreatorSubscription[]  @relation("Subscriber")
  subscribers         CreatorSubscription[]  @relation("Creator")
  creatorPosts        CreatorPost[]
  sponsorApplications SponsorApplication[]
  products            Product[]
  orders              Order[]
  reportsMade         Report[]               @relation("Reporter")
  reportsAgainst      Report[]               @relation("ReportedUser")
  auditLogs           AuditLog[]
  sessions            Session[]
  messagesSent        Message[]
  conversations       ConversationMember[]
  passportDocs        PassportDocument[]
  spotlights          Spotlight[]
  gymReviews          GymReview[]
  eventRegistrations  EventRegistration[]
  pushSubscriptions   PushSubscription[]
  appeals             Appeal[]

  // Faz 2/3 genişletmesi
  payments             Payment[]
  platformSubs         PlatformSubscription[]
  coachingOffers       CoachingOffer[]        @relation("CoachingOffers")
  coachingAsCoach      CoachingSession[]      @relation("CoachingAsCoach")
  coachingAsAthlete    CoachingSession[]      @relation("CoachingAsAthlete")
  ppvPurchases         PpvPurchase[]
  memberContracts      GymContract[]          @relation("ContractMember")
  invoices             Invoice[]
  deviceConnections    DeviceConnection[]

  @@index([role])
  @@index([verification])
  @@index([city, country])
  @@index([followerCount(sort: Desc)])
  @@index([lastActiveAt(sort: Desc)])
  @@index([isActive, isBanned])
  @@map("users")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Çoklu spor profili — §4.2
model SportProfile {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  discipline  Discipline
  isPrimary   Boolean    @default(false)
  level       SkillLevel @default(BEGINNER)
  belt        BeltRank   @default(NONE)
  stripes     Int        @default(0)
  weightClass String?
  weightKg    Float?
  yearsActive Int        @default(0)
  isPro       Boolean    @default(false)

  // Müsabaka bilançosu
  wins       Int @default(0)
  losses     Int @default(0)
  draws      Int @default(0)
  noContests Int @default(0)
  koWins     Int @default(0)
  subWins    Int @default(0)
  decWins    Int @default(0)

  achievements String[] @default([])
  visibility   Visibility @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, discipline])
  @@index([discipline, level])
  @@index([discipline, weightClass])
  @@map("sport_profiles")
}

/// §4.5 — KYC ve durum doğrulama talepleri
model VerificationRequest {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetLevel VerificationLevel
  status      VerificationStatus @default(PENDING)
  claimedRole Role?

  idDocUrl   String?
  idDocId    String?
  selfieUrl  String?
  selfieId   String?
  proofUrls  String[] @default([])
  proofIds   String[] @default([])
  note       String?

  reviewerId String?   @db.ObjectId
  reviewNote String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@map("verification_requests")
}

/// §4.5 — Antrenör kefaleti (max 20 öğrenci)
model Vouch {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  coachId   String @db.ObjectId
  coach     User   @relation("VouchCoach", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String @db.ObjectId
  athlete   User   @relation("VouchAthlete", fields: [athleteId], references: [id], onDelete: Cascade)

  status     VouchStatus @default(PENDING)
  gymId      String?     @db.ObjectId
  discipline Discipline?
  note       String?
  revokedAt  DateTime?
  revokeNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coachId, athleteId])
  @@index([coachId, status])
  @@index([athleteId, status])
  @@map("vouches")
}

// ---------------------------------------------------------------------------
// SALONLAR
// ---------------------------------------------------------------------------

model Gym {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  slug    String @unique
  name    String
  ownerId String? @db.ObjectId
  owner   User?   @relation("GymOwner", fields: [ownerId], references: [id])

  description String?
  disciplines Discipline[] @default([])
  logoUrl     String?
  logoId      String?
  coverUrl    String?
  coverId     String?
  gallery     Json? // [{url, publicId}]

  // Konum
  street     String?
  city       String
  postalCode String?
  country    String  @default("DE")
  lat        Float?
  lng        Float?

  phone   String?
  email   String?
  website String?
  socials Json?

  openingHours Json? // {mon:[{open,close}], ...}
  amenities    String[] @default([])

  status       GymStatus      @default(PENDING)
  isVerified   Boolean        @default(false)
  isFounder    Boolean        @default(false) // Kurucu Salon rozeti
  isHalo       Boolean        @default(false) // §13 Halo salon
  plan         MembershipPlan @default(TRIAL)
  planPrice    Float          @default(0)
  planSince    DateTime?
  trialEnabled Boolean        @default(true)
  dropInPrice  Float?

  memberCount Int   @default(0)
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)
  viewCount   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // §4.6 — Ödeme ve sözleşme yönetimi. Sözleşme modülü yalnızca pilot
  // salonlarda açılır (mevcut yazılımı olmayan yeni salonlar).
  stripeAccountId  String?
  connectStatus    ConnectStatus @default(NONE)
  contractsEnabled Boolean       @default(false)
  billingIban      String? // toplu pain.008 üretimi için alacaklı hesabı
  billingBic       String?

  memberships GymMembership[]
  coaches     GymCoach[]
  classes     GymClass[]
  bookings    Booking[]
  events      Event[]
  reviews     GymReview[]
  contracts   GymContract[]
  invoices    Invoice[]

  @@index([city, country])
  @@index([status, isVerified])
  @@index([disciplines])
  @@index([lat, lng])
  @@index([isHalo])
  @@map("gyms")
}

model GymMembership {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  gymId  String @db.ObjectId
  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isPrimary Boolean   @default(false)
  since     DateTime  @default(now())
  until     DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())

  @@unique([gymId, userId])
  @@index([userId, isActive])
  @@map("gym_memberships")
}

model GymCoach {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  gymId  String @db.ObjectId
  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String?
  disciplines Discipline[] @default([])
  isHead      Boolean      @default(false)
  licenseUrl  String?
  licenseId   String?
  verified    Boolean      @default(false)

  createdAt DateTime @default(now())

  @@unique([gymId, userId])
  @@index([userId])
  @@map("gym_coaches")
}

model GymClass {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  gymId String @db.ObjectId
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  name        String
  discipline  Discipline
  level       SkillLevel @default(BEGINNER)
  description String?
  coachName   String?

  weekday   Int // 0-6
  startTime String // "18:30"
  endTime   String
  capacity  Int    @default(20)
  price     Float  @default(0)
  isTrialOk Boolean @default(true)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([gymId, weekday])
  @@index([discipline, isActive])
  @@map("gym_classes")
}

model Booking {
  id      String    @id @default(auto()) @map("_id") @db.ObjectId
  gymId   String    @db.ObjectId
  gym     Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  classId String?   @db.ObjectId
  class   GymClass? @relation(fields: [classId], references: [id])
  userId  String    @db.ObjectId
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      BookingType   @default(TRIAL)
  status    BookingStatus @default(PENDING)
  date      DateTime
  note      String?
  price     Float         @default(0)
  // Deneme antrenmanı akışı — §4.2
  experience String?
  goals      String?
  contactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId, date])
  @@index([userId, status])
  @@index([status, date])
  @@map("bookings")
}

model GymReview {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  gymId  String @db.ObjectId
  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  @@unique([gymId, userId])
  @@index([gymId])
  @@map("gym_reviews")
}

// ---------------------------------------------------------------------------
// ANTRENMAN GÜNLÜĞÜ
// ---------------------------------------------------------------------------

model TrainingLog {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date       DateTime
  discipline Discipline
  durationMin Int       @default(60)
  intensity  Int        @default(3) // 1-5
  type       String? // teknik, sparring, kondisyon, kuvvet
  gymId      String?    @db.ObjectId
  techniques String[]   @default([])
  rounds     Int?
  caloriesKcal Int?
  notes      String?
  mood       Int? // 1-5
  weightKg   Float?
  visibility Visibility @default(PRIVATE)

  // Çevrimdışı senkron — §5.2
  clientId  String?
  syncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date(sort: Desc)])
  @@index([userId, discipline])
  // Çevrimdışı senkron tekilliği: uygulama katmanında kontrol edilir.
  // MongoDB'de null değerler unique indekste çakışacağı için burada
  // yalnızca arama indeksi tanımlanır.
  @@index([userId, clientId])
  @@map("training_logs")
}

// ---------------------------------------------------------------------------
// SPARRING
// ---------------------------------------------------------------------------

model SparringListing {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  discipline  Discipline
  level       SkillLevel
  weightKg    Float?
  weightTolerance Float @default(5)
  city        String
  postalCode  String?
  lat         Float?
  lng         Float?
  radiusKm    Int      @default(25)
  gymId       String?  @db.ObjectId
  availability String[] @default([]) // ["MON_EVENING", ...]
  dateFrom    DateTime?
  dateTo      DateTime?
  intensity   String   @default("MEDIUM") // LIGHT | MEDIUM | HARD
  note        String?
  genderPref  String?
  minAge      Int?
  maxAge      Int?

  status    SparringStatus @default(OPEN)
  viewCount Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests SparringRequest[]

  @@index([status, discipline, city])
  @@index([userId])
  @@index([lat, lng])
  @@index([createdAt(sort: Desc)])
  @@map("sparring_listings")
}

model SparringRequest {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  listingId String          @db.ObjectId
  listing   SparringListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  senderId  String          @db.ObjectId
  sender    User            @relation("SparringSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String         @db.ObjectId

  message      String?
  status       SparringRequestStatus @default(PENDING)
  proposedDate DateTime?
  // Sparring sözleşmesi onayı — §11.2
  waiverAccepted Boolean @default(false)
  waiverAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews SparringReview[]

  @@unique([listingId, senderId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@map("sparring_requests")
}

/// §11.2 — Sparring güvenliği: her sparring sonrası değerlendirme
model SparringReview {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  requestId String           @db.ObjectId
  request   SparringRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String           @db.ObjectId
  author    User             @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String           @db.ObjectId
  target    User             @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  safety      Int // 1-5 — kontrollü mü
  technique   Int
  punctuality Int
  wouldRepeat Boolean @default(true)
  comment     String?
  flagUnsafe  Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([requestId, authorId])
  @@index([targetId])
  @@map("sparring_reviews")
}

// ---------------------------------------------------------------------------
// ETKİNLİK & LIVESCORE
// ---------------------------------------------------------------------------

model Event {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  slug        String @unique
  title       String
  organizerId String @db.ObjectId
  organizer   User   @relation("EventOrganizer", fields: [organizerId], references: [id])
  gymId       String? @db.ObjectId
  gym         Gym?    @relation(fields: [gymId], references: [id])

  description String?
  type        EventType   @default(AMATEUR)
  status      EventStatus @default(DRAFT)
  disciplines Discipline[] @default([])

  posterUrl String?
  posterId  String?

  startsAt DateTime
  endsAt   DateTime?
  doorsAt  DateTime?

  venueName  String?
  street     String?
  city       String
  postalCode String?
  country    String  @default("DE")
  lat        Float?
  lng        Float?

  ticketUrl    String?
  ticketPrice  Float?
  capacity     Int?
  streamUrl    String?
  isPPV        Boolean @default(false)
  ppvPrice     Float?
  registrationOpen Boolean @default(false)
  registrationDeadline DateTime?

  viewCount     Int @default(0)
  followerCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fights        Fight[]
  liveComments  LiveComment[]
